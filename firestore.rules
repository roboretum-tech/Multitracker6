rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTenantOwner() {
      return isSignedIn() && resource.data.tenantId == request.auth.uid;
    }

    function isCreatingForTenant() {
      return isSignedIn() && request.resource.data.tenantId == request.auth.uid;
    }

    // Users profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Tenant-scoped collections
    match /projects/{projectId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /meetings/{meetingId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /communications/{commId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /invoices/{invoiceId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /teamMembers/{memberId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /risks/{riskId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /decisions/{decisionId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /agreements/{agreementId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read, delete: if isTenantOwner();
      allow create: if isCreatingForTenant();
      allow update: if isTenantOwner() && request.resource.data.tenantId == request.auth.uid;
    }
  }
}
